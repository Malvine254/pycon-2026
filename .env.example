# Copy this file to .env and fill in your values. Never commit .env.

# --- Mela web app ---
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Microsoft Foundry (cloud) ---
# Endpoint from your Foundry resource, e.g. https://<your-resource>.openai.azure.com
FOUNDRY_ENDPOINT=
# Workshop: use the key from the facilitators. Own Azure account: leave empty and run `az login`.
FOUNDRY_API_KEY=
FOUNDRY_DEPLOYMENT=gpt-5-mini
FOUNDRY_API_VERSION=2025-08-07

# --- Local model: Phi on Foundry Local ---
LOCAL_MODEL=phi-3.5-mini
# Leave empty: the endpoint is read from `foundry server status` (the port changes on restart).
# Only set it if auto-detection fails, e.g. LOCAL_ENDPOINT=http://127.0.0.1:5273
LOCAL_ENDPOINT=

# --- Cost tracking (configured model list prices, USD per 1K tokens) ---
USD_TO_KES=129
CLOUD_INPUT_USD_PER_1K=0.00015
CLOUD_OUTPUT_USD_PER_1K=0.0006
